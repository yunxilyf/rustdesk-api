# rustdesk-api-server 环境变量示例
# 用法：复制为 .env 后按需修改。已存在的系统环境变量优先于本文件。
#   Linux/macOS:  cp .env.example .env && vi .env
#   Windows:      copy .env.example .env
# 也可以不用 .env，直接在 systemd / Docker / 启动脚本里注入环境变量。

# ---------- 基础 ----------
# 调试开关：0/false 关闭（生产必须关闭），1/true 打开
DEBUG=0
# 生产必须替换：python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=please-change-me
# 逗号分隔；生产不要用 *
ALLOWED_HOSTS=rd.example.com,10.0.0.10
# 控制台/管理后台通过哪个来源访问（含协议与端口）
CSRF_TRUSTED_ORIGINS=https://rd.example.com
# RustDesk Web 客户端使用的 ID 服务器，默认与 API 同主机
LANGUAGE_CODE=zh-hans
# 是否允许自助注册；商业化场景建议 0，由管理员建号
ALLOW_REGISTRATION=0

# ---------- HTTPS / 反向代理 ----------
# 用 HTTPS 对外服务时置 1：开启 Secure Cookie、HSTS、SSL 跳转
HTTPS=1
# 在 nginx/caddy 等可信代理后面时置 1，信任 X-Forwarded-Proto
BEHIND_PROXY=1
# 如需单独控制：
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=31536000
# SESSION_COOKIE_SECURE=1
# CSRF_COOKIE_SECURE=1

# ---------- 缓存 / 登录节流 ----------
# 多进程、多实例部署必须配 Redis（pip install -r requirements-prod.txt），
# 否则每个进程各自计数，节流形同虚设。单进程可留空用进程内缓存。
CACHE_URL=redis://127.0.0.1:6379/0
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_SECONDS=300
PASSWORD_VALIDATION=1

# ---------- 数据库（默认 SQLite） ----------
DATABASE_TYPE=SQLITE
# DATABASE_TYPE=MYSQL
# MYSQL_DBNAME=rustdesk
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=rustdesk
# MYSQL_PASSWORD=change-me
# DB_CONN_MAX_AGE=60

# ---------- 文件与日志 ----------
# 会话录像目录，默认 <项目>/records
# RECORD_ROOT=/var/lib/rustdesk-api/records
# 日志目录，默认 <项目>/logs（自动按 10MB 轮转，保留 5 份）
# LOG_DIR=/var/log/rustdesk-api
LOG_LEVEL=INFO
# 单请求体上限（录像分片为 8MB，留余量）
# DATA_UPLOAD_MAX_MEMORY_SIZE=10485760

# ---------- 数据库 ----------
# SQLITE（默认，已自动开启 WAL）/ MYSQL / POSTGRES
DATABASE_TYPE=SQLITE
# 非 SQLITE 时填写（Postgres 生产推荐）
# DB_NAME=rustdesk
# DB_USER=rustdesk
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_CONN_MAX_AGE=60
# SQLITE_TIMEOUT=20

# ---------- 心跳写入节流（大规模部署的关键参数）----------
# 设备在线时间戳最多每 N 秒写一次；token 剩余不足 M 秒才续期。
# 默认值下，单台设备约每 10 分钟才产生 1 次写库。
HEARTBEAT_DEVICE_TOUCH_SECONDS=120
HEARTBEAT_TOKEN_REFRESH_SECONDS=600
# 「在线」判定窗口（秒）。必须大于 HEARTBEAT_DEVICE_TOUCH_SECONDS，否则设备会闪成离线。
DEVICE_ONLINE_SECONDS=300
