# rustdesk-api-server 环境变量示例
# 用法：复制为 .env 后按需修改。已存在的系统环境变量优先于本文件。
#   Linux/macOS:  cp .env.example .env && vi .env
#   Windows:      copy .env.example .env
# 也可以不用 .env，直接在 systemd / Docker / 启动脚本里注入环境变量。

# ---------- 基础 ----------
# 调试开关：0/false 关闭（生产必须关闭），1/true 打开
DEBUG=0
# DEBUG=0 时必填。生成方法见 README。
SECRET_KEY=
# 逗号分隔；生产填写实际域名/IP，不要用 *
ALLOWED_HOSTS=127.0.0.1,localhost
# 控制台/管理后台通过哪个来源访问（含协议与端口）
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:21114
# 界面语言：zh-hans（简体中文）/ en（英文）
LANGUAGE_CODE=zh-hans
# 是否允许自助注册；商业化场景建议 0，由管理员建号
ALLOW_REGISTRATION=0
# 注册/网页初始化的每 IP 每小时上限（防批量注册与密钥爆破）
# REGISTER_MAX_PER_HOUR=10
# SETUP_MAX_PER_HOUR=10
# 可选。首次网页初始化使用独立随机密钥，完成后清除。
# WEB_SETUP_TOKEN=

# ---------- HTTPS / 反向代理 ----------
# 用 HTTPS 对外服务时置 1：开启 Secure Cookie、HSTS、SSL 跳转
HTTPS=0
# 在 nginx/caddy 等可信代理后面时置 1，信任 X-Forwarded-Proto
BEHIND_PROXY=0
# 可选：多层代理（如 CDN + nginx）时显式指定可信代理跳数；默认自动推导
# TRUSTED_PROXY_COUNT=
# 如需单独控制：
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=31536000
# SESSION_COOKIE_SECURE=1
# CSRF_COOKIE_SECURE=1

# ---------- 缓存 / 登录节流 ----------
# 多进程、多实例部署必须有共享缓存，否则每个进程各自计数，节流形同虚设。
# 没有 Redis 时可用数据库缓存（CACHE_BACKEND=db，自动建 rustdesk_cache 表）。
# CACHE_URL=redis://127.0.0.1:6379/0
# CACHE_BACKEND=db
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_SECONDS=300
PASSWORD_VALIDATION=1
# 健康检查详情（版本/数据库/缓存）默认只对本机开放；
# 远端监控需带 X-Health-Token 请求头才能读取完整信息。
# HEALTH_TOKEN=

# ---------- 数据库 ----------
# SQLITE（默认，已自动开启 WAL）/ MYSQL（需 8.4+）/ POSTGRES
DATABASE_TYPE=SQLITE
# 非 SQLITE 时填写（Postgres 生产推荐）
# DB_NAME=rustdesk
# DB_USER=rustdesk
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_CONN_MAX_AGE=60
# SQLITE_TIMEOUT=20
# 兼容旧变量名：MYSQL_DBNAME / MYSQL_HOST / MYSQL_USER / MYSQL_PASSWORD / MYSQL_PORT

# ---------- 登录态与心跳写入节流（大规模部署的关键参数） ----------
# 客户端 token 有效期（秒），默认 30 天；离线超过该时长才需要重新登录。
# TOKEN_TTL_SECONDS=2592000
# 设备在线时间戳最多每 N 秒写一次。有效令牌只在认证请求到达且剩余不足 M 秒时续期。
HEARTBEAT_DEVICE_TOUCH_SECONDS=120
HEARTBEAT_TOKEN_REFRESH_SECONDS=86400
# 「在线」判定窗口（秒）。必须大于 HEARTBEAT_DEVICE_TOUCH_SECONDS，否则设备会闪成离线。
DEVICE_ONLINE_SECONDS=300

# ---------- 文件与日志 ----------
# 历史录像目录，默认 <项目>/records
# RECORD_ROOT=/var/lib/rustdesk-api/records
# 日志目录，默认 <项目>/logs（自动按 10MB 轮转，保留 5 份）
# LOG_DIR=/var/log/rustdesk-api
LOG_LEVEL=INFO
# 单请求体上限
# DATA_UPLOAD_MAX_MEMORY_SIZE=10485760

# ---------- OIDC 登录（可选，控制台也可配置） ----------
# 配置后客户端登录页出现 OIDC 按钮；回调地址 <API 域名>/api/oidc/callback 需在 IdP 登记。
# OIDC_ISSUER=https://id.example.com/realms/main
# OIDC_CLIENT_ID=rustdesk-api
# OIDC_CLIENT_SECRET=change-me
# OIDC_BUTTON_LABEL=公司 SSO
# OIDC_SCOPES=openid profile email
# OIDC_REDIRECT_URI=https://rustdeskapi.example.com/api/oidc/callback
# OIDC_USERNAME_CLAIM=preferred_username
# OIDC_AUTO_CREATE=1
# OIDC_ALLOW_EMAIL_LINK=0
# OIDC_MAX_PER_HOUR=60

# ===== 网页远控（/web/）=====
# 不填时 idServer 自动取访问域名；API_SERVER 不填时按 https://<访问域名> 生成。
# ID_SERVER=rustdesk.example.com
# API_SERVER=https://rustdesk.example.com
# 免安装版没有 nginx 代理 WebSocket，需要把 ID/中继直接指向 hbbs/hbbr 的 WS 端口：
# ID_SERVER=192.168.1.20:21118
# RELAY_SERVER=192.168.1.20:21119
# hbbs 公钥（docker logs hbbs 首行 Key），用于网页端直连。
# RUSTDESK_KEY=
# 网页远控自动校验控制台登录会话并共享登录态，无需单独配置 Cookie。
